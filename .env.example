# Postgres connection string from Neon (https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL used for sitemap, robots, and Open Graph
NEXT_PUBLIC_SITE_URL="https://www.kasbahenglish.com"

# Google Analytics 4 Measurement ID (optional). Example: G-XXXXXXXXXX
# Create at: https://analytics.google.com → Admin → Data streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Where application/contact notifications are emailed
CONTACT_EMAIL="mohamed.ketrani.zinati@gmail.com"

# Welcome email after accepting a member (Gmail App Password recommended)
# Create at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER="mohamed.ketrani.zinati@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Or generic SMTP instead of Gmail:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="mohamed.ketrani.zinati@gmail.com"
# SMTP_PASS="your-app-password"

